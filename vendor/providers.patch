+
+const tick = () => new Promise((resolve) => setTimeout(resolve, 10));
+
+describe("SelectedDocProvider, where the site says where it is", () => {
+  let params = new URLSearchParams();
+
+  beforeEach(() => {
+    params = new URLSearchParams();
+    window.patchworkRoute = { params: () => new URLSearchParams(params) };
+  });
+
+  afterEach(() => {
+    delete window.patchworkRoute;
+  });
+
+  it("selects the route's document, not the hash's", async () => {
+    const views: unknown[] = [];
+    subscribe(child, { type: "patchwork:selected-view" }, (view) =>
+      views.push(view)
+    );
+    params = new URLSearchParams({ doc: APPLES, tool: "outline" });
+    // the site announces a move as a change of hash
+    window.dispatchEvent(new HashChangeEvent("hashchange"));
+    await tick();
+    expect(views.at(-1)).toEqual({ url: APPLES, toolId: "outline" });
+    expect(location.hash).toBe("");
+  });
+
+  it("selects the route's document as it starts", async () => {
+    params = new URLSearchParams({ doc: APPLES });
+    const host = document.createElement("div");
+    document.body.append(host);
+    const stop = SelectedDocProvider(host);
+    const seen: unknown[] = [];
+    subscribe(host, { type: "patchwork:selected-doc" }, (urls) =>
+      seen.push(urls)
+    );
+    await tick();
+    expect(seen.at(-1)).toEqual([APPLES]);
+    stop();
+    host.remove();
+  });
+});
