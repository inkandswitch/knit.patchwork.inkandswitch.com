diff --git a/src/packages.test.tsx b/src/packages.test.tsx
index 8d76346..1b4a665 100644
--- a/src/packages.test.tsx
+++ b/src/packages.test.tsx
@@ -77,3 +77,31 @@ describe("the filter box", () => {
     expect(element.querySelector(".pw-pkg-modal")).toBeNull();
   });
 });
+
+// knit only installs http(s) packages
+describe("the install modal", () => {
+  function paste(search: HTMLInputElement, text: string) {
+    const event = new Event("paste", { bubbles: true, cancelable: true });
+    Object.defineProperty(event, "clipboardData", {
+      value: { getData: () => text },
+    });
+    search.dispatchEvent(event);
+  }
+
+  it("won't install an automerge url", () => {
+    const { element, search } = mount();
+    paste(search, "automerge:3psiCwUeZNMFrmtiAkX75Jvy1tED");
+    const add = element.querySelector<HTMLButtonElement>(".pw-pkg-install__add");
+    expect(add?.disabled).toBe(true);
+    expect(element.querySelector(".pw-pkg-install__error")?.textContent).toMatch(
+      /Only http/
+    );
+  });
+
+  it("will install an https url", () => {
+    const { element, search } = mount();
+    paste(search, "https://example.com/tool/");
+    const add = element.querySelector<HTMLButtonElement>(".pw-pkg-install__add");
+    expect(add?.disabled).toBe(false);
+  });
+});
