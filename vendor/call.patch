+// a lattice or knitout project's own doc is its layout, which is each
+// person's own: what's shared is its files (a folder), so that's its room.
+// (knit: vendor/call.patch)
+const PROJECT_TYPES = new Set(["lattice:project", "knitoutjs-project", "knitoutjs-panes", "prototype-knitoutjs-panes"]);
+
+/** a project doc's files (the room it's in), or null for any other doc */
+export function projectFiles(doc) {
+  if (!PROJECT_TYPES.has(doc?.["@patchwork"]?.type)) return null;
+  const files = roomUrl(doc.files);
+  return files && !isKeyRoom(files) ? files : null;
+}
+
+/** the room `url` names, once its doc's been looked at: a project's is its files */
+export async function sharedRoom(url) {
+  const id = roomUrl(url);
+  const repo = pageRepo();
+  if (!id || isKeyRoom(id) || !repo) return id;
+  try {
+    return projectFiles((await repo.find(id)).doc?.()) ?? id;
+  } catch {
+    return id;
+  }
+}
+
 /** the page's repo, wherever this host put it (not a draft overlay's) */
