@@ -0,0 +1,86 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { createSignal } from "solid-js";
+import { render } from "solid-js/web";
+import type { AutomergeUrl } from "@automerge/automerge-repo/slim";
+import { MainDocumentView } from "./MainDocumentView";
+
+let host: HTMLElement;
+let dispose: () => void;
+const [docUrl, setDocUrl] = createSignal<AutomergeUrl | undefined>();
+
+function mount() {
+  dispose = render(
+    () => (
+      <MainDocumentView
+        viewKey={docUrl}
+        selectedDocUrl={docUrl}
+        toolId={() => undefined}
+      />
+    ),
+    host
+  );
+}
+
+const card = (text: string) => {
+  const element = document.createElement("div");
+  element.className = "site-card";
+  element.textContent = text;
+  return element;
+};
+
+beforeEach(() => {
+  setDocUrl(undefined);
+  host = document.body.appendChild(document.createElement("div"));
+});
+afterEach(() => {
+  dispose?.();
+  host.remove();
+  delete window.patchworkRoute;
+});
+
+describe("MainDocumentView with nothing open", () => {
+  it("asks you to pick a doc, when the site has nothing to say", () => {
+    mount();
+    expect(host.querySelector(".placeholder")?.textContent).toBe(
+      "Select a document in the sidebar"
+    );
+  });
+
+  it("shows the site's placeholder instead, when it has one", () => {
+    window.patchworkRoute = { placeholder: () => card("not in your sidebar") };
+    mount();
+    expect(host.querySelector(".placeholder")).toBeNull();
+    expect(host.querySelector(".site-card")?.textContent).toBe(
+      "not in your sidebar"
+    );
+  });
+
+  it("asks the site again when the route moves", () => {
+    let text: string | undefined;
+    window.patchworkRoute = { placeholder: () => (text ? card(text) : null) };
+    mount();
+    expect(host.querySelector(".placeholder")).not.toBeNull();
+    text = "looking";
+    window.dispatchEvent(new HashChangeEvent("hashchange"));
+    expect(host.querySelector(".site-card")?.textContent).toBe("looking");
+    text = "not in your sidebar";
+    window.dispatchEvent(new HashChangeEvent("hashchange"));
+    expect(host.querySelectorAll(".site-card")).toHaveLength(1);
+    expect(host.querySelector(".site-card")?.textContent).toBe(
+      "not in your sidebar"
+    );
+    text = undefined;
+    window.dispatchEvent(new HashChangeEvent("hashchange"));
+    expect(host.querySelector(".site-card")).toBeNull();
+    expect(host.querySelector(".placeholder")).not.toBeNull();
+  });
+
+  it("shows neither once a doc is open", () => {
+    window.patchworkRoute = { placeholder: () => card("not in your sidebar") };
+    mount();
+    setDocUrl("automerge:2hYBuGqvRixHMWj7Wt4yRrqJNq3u" as AutomergeUrl);
+    expect(host.querySelector(".site-card")).toBeNull();
+    expect(host.querySelector(".placeholder")).toBeNull();
+    expect(host.querySelector("patchwork-view")).not.toBeNull();
+  });
+});
