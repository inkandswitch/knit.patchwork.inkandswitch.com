+
+// the <patchwork-view> is always told which tool, and only once that tool's
+// registered: left to itself, a doc with no tool for its datatype has it
+// offering to load the doc's suggestedImportUrl. we just say there's no tool,
+// until one arrives with a package
+function DocumentView(props: {
+  url: AutomergeUrl;
+  toolId: Accessor<string | undefined>;
+  path?: Accessor<string | undefined>;
+  repo: Repo | null;
+}) {
+  const tools = getRegistry("patchwork:tool");
+  const [toolsChanged, setToolsChanged] = createSignal(0);
+  onCleanup(
+    tools.on("changed", () => {
+      setToolsChanged((n) => n + 1);
+    })
+  );
+
+  // the doc, to see what it is: undefined while it loads, null if it can't
+  const [doc, setDoc] = createSignal<HasPatchworkMetadata | null>();
+  async function look(repo: Repo | null): Promise<void> {
+    try {
+      const handle = await repo?.find<HasPatchworkMetadata>(props.url);
+      setDoc(handle?.doc() ?? null);
+    } catch {
+      setDoc(null);
+    }
+  }
+  void look(props.repo);
+
+  const tool = createMemo(() => {
+    toolsChanged();
+    const d = doc();
+    if (d === undefined) return undefined;
+    const type = d ? getType(d) : undefined;
+    let id = props.toolId();
+    if (!id && d && type) {
+      try {
+        const fallback = getFallbackTool(d);
+        // a "*" tool (raw) will open anything, but it isn't this datatype's
+        // tool: say there's none rather than show the doc's insides
+        if (fallback && !opensOnlyAsAnything(fallback.supportedDatatypes, type))
+          id = fallback.id;
+      } catch {}
+    }
+    // no datatype at all: patchwork-view says what's wrong with it
+    return { id, type, missing: !!type && !(id && tools.get(id)) };
+  });
+
+  return (
+    <Show when={tool()}>
+      {(t) => (
+        <Show
+          when={!t().missing}
+          fallback={<NoTool type={t().type!} url={props.url} />}
+        >
+          <patchwork-view
+            doc-url={props.url}
+            tool-id={t().id}
+            // Where it was opened from, as an attribute: patchwork-view's
+            // JSX typings predate `path`.
+            ref={(view: HTMLElement) =>
+              createEffect(() => {
+                const at = props.path?.();
+                if (at) view.setAttribute("path", at);
+                else view.removeAttribute("path");
+              })
+            }
+          />
+        </Show>
+      )}
+    </Show>
+  );
+}
+
+// whether a tool takes `type` only because it takes "*"
+function opensOnlyAsAnything(
+  supported: "*" | string[],
+  type: string
+): boolean {
+  const list = supported === "*" ? ["*"] : supported;
+  return list.includes("*") && !list.includes(type);
+}
+
+// a filter per seed; the heading steps through them while you're near
+const ROUGH_SEEDS = [1, 2, 3] as const;
+
+// the card for a doc nothing here can open. it settles the main view as
+// patchwork-view would, so the sidebar doesn't wait on it
+function NoTool(props: { type: string; url: AutomergeUrl }) {
+  let card!: HTMLDivElement;
+  onMount(() => {
+    card.dispatchEvent(
+      new CustomEvent("patchwork:no-tool", {
+        bubbles: true,
+        composed: true,
+        detail: { url: props.url },
+      })
+    );
+  });
+  return (
+    <div class="no-tool" ref={card}>
+      {/* the heading's hand-drawn wobble, as lattice draws it */}
+      <svg class="no-tool__defs" aria-hidden="true">
+        <For each={ROUGH_SEEDS}>
+          {(seed) => (
+            <filter id={`no-tool-rough-${seed}`}>
+              <feTurbulence
+                type="fractalNoise"
+                baseFrequency="0.04"
+                numOctaves="2"
+                seed={seed}
+              />
+              <feDisplacementMap in="SourceGraphic" scale="1.4" />
+            </filter>
+          )}
+        </For>
+      </svg>
+      <div class="no-tool__card">
+        <h2 class="no-tool__rough">no tool for this</h2>
+        <p>
+          it's a <code class="no-tool__type">{props.type}</code>, and nothing
+          here knows how to open one yet.
+        </p>
+        <p>if a package brings a tool for it, it'll open right here.</p>
+      </div>
+    </div>
+  );
+}
