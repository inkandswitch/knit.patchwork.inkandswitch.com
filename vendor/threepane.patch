+// of "Select a document in the sidebar": a path that names a doc that isn't
+// here, say. It still announces a move with a hashchange.
+// (knit.patchwork.inkandswitch.com's src/route.ts)
+declare global {
+  interface Window {
+    patchworkRoute?: { placeholder?(): Node | null | undefined };
+  }
+}
 
 interface MainDocumentViewProps {
   viewKey: Accessor<string | undefined>;
@@ -22,6 +34,16 @@ export function MainDocumentView({
   toolId,
   ref,
 }: MainDocumentViewProps) {
+  // the site's placeholder is asked for again whenever the route moves
+  const [moved, setMoved] = createSignal(0, { equals: false });
