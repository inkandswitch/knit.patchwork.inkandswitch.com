           <patchwork-view doc-url={selectedDocUrl()!} tool-id={toolId()} />
         )}
       </Show>
-      {!selectedDocUrl() && (
-        <div class="placeholder">Select a document in the sidebar</div>
-      )}
+      {!selectedDocUrl() &&
+        (sitePlaceholder() ?? (
+          <div class="placeholder">Select a document in the sidebar</div>
+        ))}
     </div>
   );
 }
