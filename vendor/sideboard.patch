diff --git a/src/sideboard/knit-archives.ts b/src/sideboard/knit-archives.ts
new file mode 100644
index 0000000..428a9e4
--- /dev/null
+++ b/src/sideboard/knit-archives.ts
@@ -0,0 +1,114 @@
+import {
+  isValidAutomergeUrl,
+  type AutomergeUrl,
+  type Repo,
+} from "@automerge/automerge-repo/slim";
+import {
+  getRegistry,
+  type PluginDescription,
+} from "@inkandswitch/patchwork-plugins";
+import type { DocLink } from "@inkandswitch/patchwork-filesystem";
+import { docLinkFromUrl } from "./lib/doc-link.ts";
+
+// knit: a "patchwork:archive" plugin (the amtext package's .patchworkfolder)
+// packs a doc and every doc it links to into one file, and unpacks one again.
+// Folders can be downloaded as one from their context menu, and dropping or
+// picking a file with its extension unpacks it rather than adding the file, as
+// does pasting an http(s) link to one into the create-new menu's filter.
+export interface ArchiveDescription extends PluginDescription {
+  /** e.g. ".patchworkfolder" */
+  extension: string;
+  /** taken when dropped or picked, but not offered as a download */
+  importOnly?: boolean;
+  /**
+   * taken only from a link: a file of it from the computer is added as the
+   * file it is (an .amtext, say, which can be edited as text)
+   */
+  linkOnly?: boolean;
+}
+
+export interface Archive {
+  download(repo: Repo, url: AutomergeUrl): Promise<unknown>;
+  /** resolves with the url of the doc the archive was made from */
+  import(repo: Repo, file: Blob): Promise<AutomergeUrl>;
+}
+
+const registry = () => getRegistry<ArchiveDescription>("patchwork:archive");
+
+/** The archive formats there are, for listing in a menu. */
+export const archives = () =>
+  registry().filter((archive) => typeof archive.extension === "string");
+
+/** The archive formats a folder can be downloaded as. */
+export const downloadableArchives = () =>
+  archives().filter((archive) => !archive.importOnly);
+
+const named = (filename: string) => (archive: ArchiveDescription) =>
+  filename.toLowerCase().endsWith(archive.extension.toLowerCase());
+
+/** The archive format a file from the computer with this name is in, if any. */
+export const archiveFor = (filename: string) =>
+  archives().find((archive) => !archive.linkOnly && named(filename)(archive));
+
+/**
+ * The archive an http(s) url is of, going by the end of its path (a
+ * .patchworkfolder, .latticeproject or .amtext on the web), if it's of one.
+ */
+export function archiveAt(text: string) {
+  let url: URL;
+  try {
+    url = new URL(text.trim());
+  } catch {
+    return undefined;
+  }
+  if (url.protocol !== "http:" && url.protocol !== "https:") return undefined;
+  const archive = archives().find(named(decodeURIComponent(url.pathname)));
+  return archive && { url, archive };
+}
+
+/** Fetches an archive from the web and unpacks it, resolving with its doc's url. */
+async function importFromWeb(
+  repo: Repo,
+  { url, archive }: NonNullable<ReturnType<typeof archiveAt>>
+): Promise<AutomergeUrl> {
+  const response = await fetch(url);
+  if (!response.ok) throw new Error(`${response.status} ${response.statusText}`);
+  const name = decodeURIComponent(url.pathname.split("/").pop() ?? "");
+  const file = new File([await response.blob()], name);
+  return (await loadArchive(archive.id)).import(repo, file);
+}
+
+/**
+ * What's pasted into the create-new filter, as a doc to add: one by its
+ * automerge url, or one unpacked from an archive at an http(s) url. Nothing,
+ * for anything else.
+ */
+export async function docLinkFromText(
+  repo: Repo,
+  text: string
+): Promise<DocLink | undefined> {
+  const trimmed = text.trim();
+  if (isValidAutomergeUrl(trimmed)) return docLinkFromUrl(repo, trimmed);
+  const web = archiveAt(trimmed);
+  if (web) return docLinkFromUrl(repo, await importFromWeb(repo, web));
+  return undefined;
+}
+
+export async function loadArchive(id: string): Promise<Archive> {
+  const archive = await registry().load(id);
+  if (!archive) throw new Error(`no archive format "${id}"`);
+  return archive.module as Archive;
+}
+
+export async function downloadArchive(
+  repo: Repo,
+  archive: ArchiveDescription,
+  url: AutomergeUrl
+) {
+  try {
+    await (await loadArchive(archive.id)).download(repo, url);
+  } catch (error) {
+    console.error(`sideboard: ${archive.extension} download failed`, error);
+    alert(`Couldn't download that as a ${archive.extension}.`);
+  }
+}
