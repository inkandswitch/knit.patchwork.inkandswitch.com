diff --git a/src/sideboard/knit-datatypes.ts b/src/sideboard/knit-datatypes.ts
new file mode 100644
index 0000000..962f0a6
--- /dev/null
+++ b/src/sideboard/knit-datatypes.ts
@@ -0,0 +1,29 @@
+import type {
+  DatatypeDescription,
+  Plugin,
+} from "@inkandswitch/patchwork-plugins";
+import { useFilteredDatatypes } from "./lib/solid-plugins";
+
+// knit: knitoutjs projects come first, and files are made from inside them.
+// the create-new dropdown and the right-click Create menu both list from here
+const PINNED = "knitoutjs-panes";
+const HIDDEN = new Set(["new-file"]);
+const RENAMED: Record<string, string> = { [PINNED]: "KnitoutJS Project" };
+
+// a broken plugin may register without a name; show its id rather than
+// letting it take the whole menu down
+export const label = (d: Plugin<DatatypeDescription>) =>
+  RENAMED[d.id] ?? (typeof d.name === "string" ? d.name : String(d.id));
+
+/** The datatypes you can make, in the order the menus show them. */
+export function useCreatableDatatypes() {
+  const datatypes = useFilteredDatatypes(
+    (item) => !item.unlisted && !HIDDEN.has(item.id)
+  );
+  return () =>
+    [...datatypes].sort(
+      (a, b) =>
+        Number(b.id === PINNED) - Number(a.id === PINNED) ||
+        label(a).localeCompare(label(b))
+    );
+}
