index 0000000..61c71b4
--- /dev/null
+++ b/src/sideboard/knit-archives.ts
@@ -0,0 +1,51 @@
+import type { AutomergeUrl, Repo } from "@automerge/automerge-repo/slim";
+import {
+  getRegistry,
+  type PluginDescription,
+} from "@inkandswitch/patchwork-plugins";
+
+// knit: a "patchwork:archive" plugin (the amtext package's .patchworkfolder)
+// packs a doc and every doc it links to into one file, and unpacks one again.
+// Folders can be downloaded as one from their context menu, and dropping or
+// picking a file with its extension unpacks it rather than adding the file.
+export interface ArchiveDescription extends PluginDescription {
+  /** e.g. ".patchworkfolder" */
+  extension: string;
+}
+
+export interface Archive {
+  download(repo: Repo, url: AutomergeUrl): Promise<unknown>;
+  /** resolves with the url of the doc the archive was made from */
+  import(repo: Repo, file: Blob): Promise<AutomergeUrl>;
+}
+
+const registry = () => getRegistry<ArchiveDescription>("patchwork:archive");
+
+/** The archive formats there are, for listing in a menu. */
+export const archives = () =>
+  registry().filter((archive) => typeof archive.extension === "string");
+
+/** The archive format a file with this name is in, if any. */
+export const archiveFor = (filename: string) =>
+  archives().find((archive) =>
+    filename.toLowerCase().endsWith(archive.extension.toLowerCase())
+  );
+
+export async function loadArchive(id: string): Promise<Archive> {
+  const archive = await registry().load(id);
+  if (!archive) throw new Error(`no archive format "${id}"`);
+  return archive.module as Archive;
+}
+
+export async function downloadArchive(
+  repo: Repo,
+  archive: ArchiveDescription,
+  url: AutomergeUrl
+) {
+  try {
+    await (await loadArchive(archive.id)).download(repo, url);
+  } catch (error) {
+    console.error(`sideboard: ${archive.extension} download failed`, error);
+    alert(`Couldn't download that as a ${archive.extension}.`);
+  }
+}
