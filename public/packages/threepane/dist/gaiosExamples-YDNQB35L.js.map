{
  "@patchwork": {
    "title": "Petri Net: Inventory purchasing",
    "type": "petrinaut-petrinet"
  },
  "petriNetDefinition": {
    "componentInstances": [],
    "differentialEquations": [
      {
        "code": "// The DETERMINISTIC half of the Ornstein-Uhlenbeck SDE\n//   d lambda = theta * (mu - lambda) dt + sigma dW.\n// The dW half is injected by the diffusion-step transition\n// (Euler-Maruyama split: drift integrates every solver step, noise\n// lands every diffusion_step). sigma = 0 turns this into a pure ODE.\nexport default Dynamics((tokens, parameters) => {\n  return tokens.map((m) => ({\n    rate: parameters.demand_theta * (parameters.demand_mu - m.rate),\n    diffusion_clock: -1,\n  }));\n});",
        "colorId": "type__market",
        "id": "de__demand",
        "name": "Demand rate: OU drift (+ diffusion clock)"
      },
      {
        "code": "export default Dynamics((tokens) => {\n  return tokens.map(() => ({ waited: 1, patience: 0, qty: 0 }));\n});",
        "colorId": "type__customer_order",
        "id": "de__waiting",
        "name": "Clock: customer order ageing"
      },
      {
        "code": "// Life ticks from order placement, wherever the stock physically\n// is (AtVendor, InTransit, DelayedShipments). Storage cost is NOT\n// charged here: the warehouse equation (de__stored) does that on\n// our own shelves; committed transit spend is already booked by\n// the spend metric.\nexport default Dynamics((tokens) => {\n  return tokens.map(() => ({ qty: 0, remaining_life: -1, holding_eur: 0, unit_price: 0, dispatch_clock: 0, transit_clock: 0 }));\n});",
        "colorId": "type__crate",
        "id": "de__shelf",
        "name": "Clock: shelf-life countdown (transit/hold — no storage charge)"
      },
      {
        "code": "export default Dynamics((tokens) => {\n  return tokens.map(() => ({ remaining: -1, qty: 0 }));\n});",
        "colorId": "type__job",
        "id": "de__production",
        "name": "Clock: production countdown"
      },
      {
        "code": "// Warehouse holding: capital + GMP storage, accrued per unit-week\n// on the stock token itself and banked to the HoldingCosts ledger when\n// the stock is discarded or written off.\nexport default Dynamics((tokens, parameters) => {\n  return tokens.map((c) => ({\n    qty: 0,\n    remaining_life: -1,\n    holding_eur: c.qty * parameters.holding_cost_rate,\n    unit_price: 0,\n    dispatch_clock: 0,\n    transit_clock: 0,\n  }));\n});",
        "colorId": "type__crate",
        "id": "de__stored",
        "name": "Shelf-life countdown + storage-cost accrual (our shelves)"
      },
      {
        "code": "// The deterministic half of dP = theta * (1 - P) dt + sigma dW.\n// The dW half is injected by the price diffusion transition\n// (same Euler-Maruyama split as demand). price_sigma = 0 freezes\n// prices at the recorded eina values.\nexport default Dynamics((tokens, parameters) => {\n  return tokens.map((p) => ({\n    level: parameters.price_theta * (1 - p.level),\n    diffusion_clock: -1,\n  }));\n});",
        "colorId": "type__price",
        "id": "de__price",
        "name": "Price index: OU drift (+ diffusion clock)"
      },
      {
        "code": "// At the vendor: shelf life burns from order placement\n// (optimistic fresh-stock reading, as v1) and the fixed\n// processing clock counts down to dispatch.\nexport default Dynamics((tokens, parameters) => {\n  return tokens.map((c) => ({\n    qty: 0,\n    remaining_life: -1,\n    holding_eur: 0,\n    unit_price: 0,\n    dispatch_clock: -1,\n    transit_clock: 0,\n  }));\n});",
        "colorId": "type__crate",
        "id": "de__at_vendor",
        "name": "Order book: shelf life + dispatch clock"
      },
      {
        "code": "// On the truck: the FITTED Gaussian transit clock counts\n// down to goods receipt.\nexport default Dynamics((tokens, parameters) => {\n  return tokens.map((c) => ({\n    qty: 0,\n    remaining_life: -1,\n    holding_eur: 0,\n    unit_price: 0,\n    dispatch_clock: 0,\n    transit_clock: -1,\n  }));\n});",
        "colorId": "type__crate",
        "id": "de__in_transit",
        "name": "Transit: shelf life + transit clock"
      },
      {
        "code": "// A scheduled production order ages while it waits for\n// materials — the shortage cost integrates over this. Every\n// real attribute needs a derivative; the quantities hold.\nexport default Dynamics((tokens, parameters) => {\n  return tokens.map((s) => ({ produce_qty: 0, consume_sonaflozin: 0, consume_flowbind: 0, waited: 1 }));\n});",
        "colorId": "type__prod_order",
        "id": "de__plan_wait",
        "name": "Scheduled batch: waiting clock"
      }
    ],
    "metrics": [
      {
        "code": "return state.places[\"DemandOutlook\"].tokens.reduce((n, t) => n + t.rate, 0);",
        "description": "The OU-evolving arrival rate lambda(t). Its mean is demand_mu; excursions are the SDE at work.",
        "id": "metric__demand_rate",
        "name": "Demand rate now (orders per week)"
      },
      {
        "code": "return state.places[\"Backlog\"].tokens.length;",
        "description": "Customer orders received and not yet fulfilled or cancelled.",
        "id": "metric__backlog",
        "name": "Backlog (orders waiting)"
      },
      {
        "code": "return state.places[\"FulfilledOrders\"].tokens.length;",
        "description": "KPI: sales completed within the horizon. Scope note (review Option A): demand is all-site sales served from site 1000; this measures whether the plant supplies the network, not final customer delivery.",
        "id": "metric__fulfilled",
        "name": "Orders fulfilled"
      },
      {
        "code": "return state.places[\"FulfilledOrders\"].tokens.reduce((n, t) => n + t.lead_time, 0);",
        "description": "Sum of `waited` at fulfilment. Average lead time = this / orders fulfilled (division done outside: 1 reduce per metric, DSL limit).",
        "id": "metric__lead_time_sum",
        "name": "Sum of fulfilment lead times (weeks)"
      },
      {
        "code": "return state.places[\"LostSales\"].tokens.length;",
        "description": "KPI: spot orders cancelled (count). Lost UNITS are the companion metric.",
        "id": "metric__lost_sales",
        "name": "Lost sales (spot orders cancelled)"
      },
      {
        "code": "return state.places[\"SonaflozinStock\"].tokens.reduce((n, t) => n + t.qty, 0);",
        "description": "Sum of stock qty on the shelf.",
        "id": "metric__raw_units_r0006",
        "name": "Raw stock on shelf, Sonaflozin (units)"
      },
      {
        "code": "return state.places[\"FlowbindMaterialStock\"].tokens.reduce((n, t) => n + t.qty, 0);",
        "description": "Sum of stock qty on the shelf.",
        "id": "metric__raw_units_r0025",
        "name": "Raw stock on shelf, Flowbind Material (units)"
      },
      {
        "code": "return state.places[\"InTransit\"].tokens.reduce((n, t) => n + t.qty, 0);",
        "description": "Sum of stock qty in transit, all vendors.",
        "id": "metric__on_order_units",
        "name": "Stock in transit (units)"
      },
      {
        "code": "return state.places[\"FinishedGoods\"].tokens.reduce((n, t) => n + t.qty, 0);",
        "description": "Sum of stock qty in the finished store.",
        "id": "metric__fg_units",
        "name": "Finished goods, Sonic Flow (units)"
      },
      {
        "code": "return state.places[\"ExpiredStock\"].tokens.reduce((n, t) => n + t.value, 0);",
        "description": "KPI: qty lost to shelf-life expiry, raw and finished. Per-material split via kind in the verifier.",
        "id": "metric__expired_units",
        "name": "Expired stock written off (units)"
      },
      {
        "code": "return state.places[\"ScrappedBatches\"].tokens.length;",
        "description": "KPI: rare-event branch; 1,000 units of product each.",
        "id": "metric__scrapped",
        "name": "Batches scrapped (QC)"
      },
      {
        "code": "return state.places[\"OrdersPlaced\"].tokens.length;",
        "description": "All vendors.",
        "id": "metric__orders_placed",
        "name": "Purchase orders placed"
      },
      {
        "code": "return state.places[\"OrdersPlaced\"].tokens.reduce((n, t) => n + t.qty * t.unit_price, 0);",
        "description": "Committed on placed orders at the price CAPTURED at order time (recorded eina/eine unit prices scaled by the OU price index). Switching fees are a separate metric.",
        "id": "metric__spend",
        "name": "Purchase spend (EUR)"
      },
      {
        "code": "return state.places[\"SwitchFees\"].tokens.length;",
        "description": "KPI: 2,500-unit Flowbind Material orders redirected to German supplier while Indian supplier was out of stock.",
        "id": "metric__switches",
        "name": "Supplier switches (substitute orders)"
      },
      {
        "code": "return state.places[\"LostShipments\"].tokens.length;",
        "description": "KPI: consignments lost in transit. The vendor reships a replacement batch (fresh dispatch leg + mean transit leg, full shelf life — the lost goods are physically gone), so a loss costs lead time, not money; the replacement keeps the order-time price.",
        "id": "metric__lost_shipments",
        "name": "Shipments lost in transit"
      },
      {
        "code": "return state.places[\"LostShipments\"].tokens.reduce((n, t) => n + t.value, 0);",
        "description": "Value of consignments lost and reshipped, at the order-time price. Not a write-off: the vendor honours the order, so the cost of a loss is the extra lead time, not the money.",
        "id": "metric__lost_shipment_value",
        "name": "Reshipped consignment value (EUR)"
      },
      {
        "code": "return state.places[\"SwitchFees\"].tokens.reduce((n, t) => n + t.value, 0);",
        "description": "Cost of redirecting orders (switch_cost per substitute order). Total purchasing cost = spend + this (added in the harness: 1 reduce per metric, DSL limit).",
        "id": "metric__switch_fees",
        "name": "Switching fees (EUR)"
      },
      {
        "code": "return state.places[\"InTransit\"].tokens.reduce((n, t) => n + (t.material === \"Sonaflozin\" ? t.qty : 0), 0);",
        "description": "Harness input: material conservation needs several sums (shelf + in transit + consumed + expired = initial + ordered); the DSL allows 1 reduce per metric, so the verifier assembles the identity from component metrics.",
        "id": "metric__conservation_r0006",
        "name": "Conservation component: Sonaflozin in-transit units"
      },
      {
        "code": "return state.places[\"FulfilledOrders\"].tokens.reduce((n, t) => n + (t.kind === \"contract\" ? 1 : 0), 0);",
        "description": "Split of fulfilled orders by segment colour.",
        "id": "metric__fulfilled_contract",
        "name": "Orders fulfilled (contract)"
      },
      {
        "code": "return state.places[\"FulfilledOrders\"].tokens.reduce((n, t) => n + t.tardiness, 0);",
        "description": "Sum over fulfilled contract orders of max(0, waited - delivery window). Demand is conserved for contracts; lateness costs money instead of orders.",
        "id": "metric__tardiness",
        "name": "Contract tardiness (order-weeks)"
      },
      {
        "code": "return state.places[\"FulfilledOrders\"].tokens.reduce((n, t) => n + t.tardiness * parameters.late_penalty_per_week, 0);",
        "description": "Contract tardiness priced at late_penalty_per_week. Composes with purchase spend and switching fees into one cost objective.",
        "id": "metric__late_penalties",
        "name": "Late-delivery penalties (EUR)"
      },
      {
        "code": "return state.places[\"DelayLog\"].tokens.length;",
        "description": "KPI: shipments that hit a customs / goods-receipt hold. The stock keeps ageing while held and is released to its shelf on the slow timescale; it cannot be lost while held (losses fire on OnOrder only — simplification).",
        "id": "metric__delays",
        "name": "Shipments delayed (cumulative)"
      },
      {
        "code": "return state.places[\"DelayedShipments\"].tokens.reduce((n, t) => n + t.qty, 0);",
        "description": "Current qty sitting in the hold, still ageing.",
        "id": "metric__delayed_units",
        "name": "Units held up in delayed shipments"
      },
      {
        "code": "return state.places[\"RawPriceIndex\"].tokens.reduce((n, t) => n + t.level, 0);",
        "description": "The OU-evolving multiplier on the recorded eina unit prices. Mean 1.0; excursions are the price SDE at work.",
        "id": "metric__price_level",
        "name": "Raw material price index (now)"
      },
      {
        "code": "return state.places[\"AtVendor\"].tokens.reduce((n, t) => n + t.qty, 0);",
        "description": "Order book: accepted orders awaiting dispatch. A vendor outage stalls this place (Ship holds the InStock token); it no longer stalls the transit pipe.",
        "id": "metric__at_vendor_units",
        "name": "Stock at vendor, not yet shipped (units)"
      },
      {
        "code": "return state.places[\"AtVendor\"].tokens.reduce((n, t) => n + (t.material === \"Sonaflozin\" ? t.qty : 0), 0);",
        "description": "Harness input, as the in-transit component.",
        "id": "metric__conservation_r0006_vendor",
        "name": "Conservation component: Sonaflozin at-vendor units"
      },
      {
        "code": "return state.places[\"HoldingCosts\"].tokens.reduce((n, t) => n + t.value, 0);",
        "description": "Storage cost accrued by stock that has since been discarded or written off. Total holding cost = this + the 3 live-accrual metrics (summed in the harness: 1 reduce per metric, DSL limit).",
        "id": "metric__holding_banked",
        "name": "Holding costs banked (EUR)"
      },
      {
        "code": "return state.places[\"SonaflozinStock\"].tokens.reduce((n, t) => n + t.holding_eur, 0);",
        "description": "Live accrual on stock currently stored.",
        "id": "metric__holding_raw1",
        "name": "Holding cost accrued, Sonaflozin shelf (EUR)"
      },
      {
        "code": "return state.places[\"FlowbindMaterialStock\"].tokens.reduce((n, t) => n + t.holding_eur, 0);",
        "description": "Live accrual on stock currently stored.",
        "id": "metric__holding_raw2",
        "name": "Holding cost accrued, Flowbind Material shelf (EUR)"
      },
      {
        "code": "return state.places[\"FinishedGoods\"].tokens.reduce((n, t) => n + t.holding_eur, 0);",
        "description": "Live accrual on stock currently stored.",
        "id": "metric__holding_fg",
        "name": "Holding cost accrued, Sonic Flow store (EUR)"
      },
      {
        "code": "return state.places[\"FulfilledOrders\"].tokens.reduce((n, t) => n + t.qty, 0);",
        "description": "Sum of fulfilled order quantities (fitted vbap sizes).",
        "id": "metric__units_sold",
        "name": "Units sold"
      },
      {
        "code": "return state.places[\"LostSales\"].tokens.reduce((n, t) => n + t.value, 0);",
        "description": "Demand that walked, in units — the volume the lost-margin costing of review change 4 will price.",
        "id": "metric__units_lost",
        "name": "Units lost (spot cancellations)"
      },
      {
        "code": "return state.places[\"Backlog\"].tokens.reduce((n, t) => n + t.qty, 0);",
        "description": "Open demand in units. Order qty is clamped >= 5 once, at arrival, so this reads it raw.",
        "id": "metric__backlog_units",
        "name": "Backlog (units waiting)"
      },
      {
        "code": "return state.places[\"ProductionOrdersWaiting\"].tokens.length;",
        "description": "afko-cadence production orders not yet started — rises when materials starve the plan.",
        "id": "metric__schedule_waiting",
        "name": "Scheduled batches waiting"
      },
      {
        "code": "return state.places[\"InventoryPosition_Sonaflozin\"].tokens.reduce((n, t) => n + t.position, 0);",
        "description": "on-hand + at-vendor + in-transit − committed; quarantined/rejected/recalled/expired excluded. The reorder-point policy's decision variable.",
        "id": "metric__position_1",
        "name": "Inventory position, Sonaflozin (units)"
      },
      {
        "code": "return state.places[\"InventoryPosition_FlowbindMaterial\"].tokens.reduce((n, t) => n + t.position, 0);",
        "description": "As the Sonaflozin position.",
        "id": "metric__position_2",
        "name": "Inventory position, Flowbind Material (units)"
      },
      {
        "code": "return state.places[\"Quarantine\"].tokens.reduce((n, t) => n + t.qty, 0);",
        "description": "Delivered but not yet quality-released — unavailable to production and excluded from the inventory position.",
        "id": "metric__quarantine_units",
        "name": "Stock in quarantine (units)"
      },
      {
        "code": "return state.places[\"RejectedStock\"].tokens.reduce((n, t) => n + t.value, 0);",
        "description": "Receipts that failed inspection (assumed ~5%).",
        "id": "metric__rejected_units",
        "name": "QC-rejected stock (units)"
      },
      {
        "code": "return state.places[\"RecalledStock\"].tokens.reduce((n, t) => n + t.value, 0);",
        "description": "Stock pulled by recall events (Recall wave scenario).",
        "id": "metric__recalled_units",
        "name": "Recalled stock (units)"
      },
      {
        "code": "return state.places[\"DisposalCosts\"].tokens.reduce((n, t) => n + t.value, 0);",
        "description": "Controlled destruction + admin on expiry, QC rejection and recalls, at the assumed EUR 1.5/unit. Excludes the sunk purchase spend and holding already counted elsewhere.",
        "id": "metric__disposal_costs",
        "name": "Disposal costs (EUR)"
      },
      {
        "code": "return state.places[\"LostSales\"].tokens.reduce((n, t) => n + t.value * parameters.unit_margin, 0);",
        "description": "Lost units x contribution margin (vbap NETPR - mbew STPRS = EUR 55.47/unit).",
        "id": "metric__lost_margin",
        "name": "Lost margin, cancelled spot (EUR)"
      },
      {
        "code": "return state.places[\"ShortageCosts\"].tokens.reduce((n, t) => n + t.value, 0);",
        "description": "waited x qty x rate charged when a late scheduled batch finally starts.",
        "id": "metric__shortage_banked",
        "name": "Production delay cost, banked (EUR)"
      },
      {
        "code": "return state.places[\"ProductionOrdersWaiting\"].tokens.reduce((n, t) => n + t.waited * t.produce_qty * parameters.shortage_cost_rate, 0);",
        "description": "The same charge accruing on batches still waiting for materials. Total shortage cost = banked + this.",
        "id": "metric__shortage_live",
        "name": "Production delay cost, accruing (EUR)"
      },
      {
        "code": "return state.places[\"OrdersPlaced\"].tokens.reduce((n, t) => n + t.qty * t.unit_price, state.places[\"HoldingCosts\"].tokens.concat(state.places[\"SwitchFees\"].tokens).concat(state.places[\"DisposalCosts\"].tokens).concat(state.places[\"ShortageCosts\"].tokens).reduce((m, t) => m + t.value, state.places[\"LostSales\"].tokens.reduce((l, t) => l + t.value * parameters.unit_margin, state.places[\"FulfilledOrders\"].tokens.reduce((f, t) => f + t.tardiness * parameters.late_penalty_per_week, state.places[\"ProductionOrdersWaiting\"].tokens.reduce((s, t) => s + t.waited * t.produce_qty * parameters.shortage_cost_rate, state.places[\"SonaflozinStock\"].tokens.concat(state.places[\"FlowbindMaterialStock\"].tokens).concat(state.places[\"FinishedGoods\"].tokens).concat(state.places[\"Quarantine\"].tokens).reduce((h, c) => h + c.holding_eur, 0))))));",
        "description": "The single objective for the optimiser: purchase spend + holding (banked + still accruing on live stock, quarantine included) + lost margin on cancelled spot + production delay (banked + accruing) + late-delivery penalties + switching fees + disposal. Equals the sum of the component metrics by construction.",
        "id": "metric__policy_cost",
        "name": "Policy cost (EUR)"
      },
      {
        "code": "return state.places[\"DemandOutlook\"].tokens.reduce((ratio, d) => state.places[\"FulfilledOrders\"].tokens.reduce((s, t) => s + t.qty, 0) / ratio, state.places[\"FulfilledOrders\"].tokens.reduce((a, t) => a + t.qty, state.places[\"LostSales\"].tokens.reduce((b, t) => b + t.value, state.places[\"Backlog\"].tokens.reduce((c, t) => c + t.qty, 0.001))));",
        "description": "Units sold over all demanded units — sold + cancelled + still in the backlog — so a policy cannot look cheap by under-buying and failing customers. Division happens in a callback over the singleton DemandOutlook token (operand-position arithmetic around a reduce miscompiles); the 0.001 seed only guards the t=0 division. Scope note (review Option A): measures site 1000 supplying the network, not final customer delivery.",
        "id": "metric__fill_rate",
        "name": "Fill rate (sold / demanded units)"
      }
    ],
    "parameters": [
      {
        "defaultValue": "4.44",
        "id": "param__demand_mu",
        "name": "Demand mean (sales order arrivals per week; FITTED vbak/vbap, all plants: 247 items / 55.6 wk)",
        "type": "real",
        "variableName": "demand_mu"
      },
      {
        "defaultValue": "0.5",
        "id": "param__demand_theta",
        "name": "Demand mean-reversion rate (per week; ASSUMED)",
        "type": "real",
        "variableName": "demand_theta"
      },
      {
        "defaultValue": "1.3",
        "id": "param__demand_sigma",
        "name": "Demand volatility (per sqrt-week; ASSUMED, same relative scale as v1-v4; 0 = ODE/L3)",
        "type": "real",
        "variableName": "demand_sigma"
      },
      {
        "defaultValue": "0.25",
        "id": "param__diffusion_step",
        "name": "Diffusion step (weeks between noise injections)",
        "type": "real",
        "variableName": "diffusion_step"
      },
      {
        "defaultValue": "4",
        "id": "param__patience",
        "name": "Spot patience mean (weeks; ASSUMED, sampled per order)",
        "type": "real",
        "variableName": "patience_weeks"
      },
      {
        "defaultValue": "1.0",
        "id": "param__cancel_rate",
        "name": "Spot cancellation hazard at the personal deadline (per week; ASSUMED, grows as (waited/patience)^2)",
        "type": "real",
        "variableName": "cancel_rate"
      },
      {
        "defaultValue": "7.0",
        "id": "param__fulfil_rate",
        "name": "Fulfilment rate when stock exists (per week)",
        "type": "real",
        "variableName": "fulfil_rate"
      },
      {
        "defaultValue": "3.0",
        "id": "param__production_start",
        "name": "Start responsiveness once a scheduled order and materials are ready (per week; ASSUMED)",
        "type": "real",
        "variableName": "production_start_rate"
      },
      {
        "defaultValue": "0.995",
        "id": "param__production_time",
        "name": "Batch duration (weeks; 0.995 per the dt-multiple defect)",
        "type": "real",
        "variableName": "production_time"
      },
      {
        "defaultValue": "0.02",
        "id": "param__scrap_rate",
        "name": "QC scrap rate while in production (per week; ASSUMED)",
        "type": "real",
        "variableName": "scrap_rate"
      },
      {
        "defaultValue": "7.0",
        "id": "param__handling_rate",
        "name": "Stock consolidation rate (per week; ASSUMED)",
        "type": "real",
        "variableName": "handling_rate"
      },
      {
        "defaultValue": "0.04",
        "id": "param__outage_rate",
        "name": "Vendor stock-out rate (per week; ASSUMED ~2/year)",
        "type": "real",
        "variableName": "outage_rate"
      },
      {
        "defaultValue": "0.5",
        "id": "param__restock_rate",
        "name": "Vendor restock rate (per week; ASSUMED ~2-week outage)",
        "type": "real",
        "variableName": "restock_rate"
      },
      {
        "defaultValue": "5000",
        "id": "param__switch_cost",
        "name": "Cost of a substitute order (EUR; ASSUMED: expedite/qualification/admin)",
        "type": "real",
        "variableName": "switch_cost"
      },
      {
        "defaultValue": "0.001",
        "id": "param__shipment_loss",
        "name": "Shipment loss rate (per week per shipment in transit; ASSUMED ~0.3% of a 3-week transit leg — real freight loss is <1%)",
        "type": "real",
        "variableName": "shipment_loss_rate"
      },
      {
        "defaultValue": "156",
        "id": "param__shelf_r0006",
        "name": "Shelf life, Sonaflozin (weeks; modal recorded 1,095 days)",
        "type": "real",
        "variableName": "shelf_life_sonaflozin"
      },
      {
        "defaultValue": "156",
        "id": "param__shelf_r0025",
        "name": "Shelf life, Flowbind Material (weeks; ASSUMED, no batch data)",
        "type": "real",
        "variableName": "shelf_life_flowbind"
      },
      {
        "defaultValue": "52",
        "id": "param__shelf_a0005",
        "name": "Shelf life, Sonic Flow (weeks; recorded 365 days)",
        "type": "real",
        "variableName": "shelf_life_sonic_flow"
      },
      {
