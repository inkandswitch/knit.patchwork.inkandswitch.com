        ],
        "lambdaCode": "export default Lambda((input, parameters) => {\n  return input[\"PlanClock\"][0].remaining <= 0;\n});",
        "lambdaType": "predicate",
        "name": "Scheduled production order (forecast-weighted plan)",
        "outputArcs": [
          {
            "placeId": "place__plan_clock",
            "weight": 1
